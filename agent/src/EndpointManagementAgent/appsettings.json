{
  "Agent": {
    "Server": {
      "BaseUrl": "https://endpoint-manager.example.internal/",
      "RequestTimeoutSeconds": 120,
      "AllowHttpForLoopbackDevelopment": false,
      "PinnedCertificateSha256": null
    },
    "HeartbeatIntervalSeconds": 60,
    "InventoryIntervalMinutes": 360,
    "SoftwareInventoryIntervalMinutes": 720,
    "JobPollIntervalSeconds": 15,
    "EnrollmentRetrySeconds": 60,
    "MaxPackageBytes": 2147483648,
    "AllowedJobTypes": [
      "INSTALL_APPLICATION",
      "COLLECT_INVENTORY",
      "REFRESH_SOFTWARE_INVENTORY",
      "ROTATE_CREDENTIAL"
    ],
    "Installer": {
      "DefaultTimeoutMinutes": 120,
      "MaximumTimeoutMinutes": 480,
      "KillProcessTreeOnTimeout": false,
      "MaximumDiagnosticCharacters": 65536,
      "PreserveFailedPackages": false
    },
    "Logging": {
      "MaximumFileBytes": 10485760,
      "RetainedFiles": 14
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  }
}
