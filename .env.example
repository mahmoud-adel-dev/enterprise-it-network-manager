# =====================================================
# Enterprise Endpoint & Network Management Platform
# Environment Variables — EXAMPLE FILE
# Copy to .env.local and fill in real values
# DO NOT commit .env.local to source control
# =====================================================

# ---- Database ----
# Path to the SQLite database file (relative or absolute)
DATABASE_PATH=./data/endpoint-manager.sqlite

# ---- Authentication ----
# REQUIRED: At least 32 characters of random data
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Session expiry in days (default: 7)
SESSION_EXPIRY_DAYS=7

# ---- Application ----
# The public base URL of this application (no trailing slash)
APP_BASE_URL=https://endpoint-manager.example.internal

NODE_ENV=production

# ---- Package Storage ----
# Directory where installer packages are stored (relative or absolute)
PACKAGE_STORAGE_PATH=./data/packages

# ---- Background Worker ----
# Number of concurrent deployment jobs the worker processes
WORKER_CONCURRENCY=5
# How often the worker polls for new jobs (seconds)
WORKER_POLL_INTERVAL_SECONDS=10

# ---- Network Discovery ----
# Enable/disable the network discovery engine
DISCOVERY_ENABLED=true

# ---- Active Directory ----
# Whether to enable the AD integration
AD_ENABLED=false

# ---- SNMP ----
SNMP_ENABLED=false

# =====================================================
# SECRETS NEVER TO INCLUDE HERE (configure server-side):
# - Domain service account passwords  (store encrypted in DB settings)
# - SNMP v3 auth/priv passphrases     (store encrypted in DB)
# - Agent enrollment tokens           (generate via UI)
# =====================================================
